#!/bin/sh
# Prepare writable directories, then become busybox init (PID 1).
# The root filesystem is read-only. Persistent data is /opt/data.
# /run and /tmp are symlinks to /dev/shm. Create subdirectories here;
# do not point them at /dev/shm with another symlink.
set -eu
mkdir -p \
  /opt/data/log \
  /opt/data/zones \
  /opt/data/catalog \
  /opt/data/spool/tmp \
  /opt/data/etc \
  /opt/data/nsd/zones \
  /opt/data/nsd/xfr \
  /opt/data/secrets \
  /run/nsd \
  /run/nginx \
  /tmp/nginx-body \
  /tmp/nginx-proxy \
  /tmp/nginx-fastcgi \
  /tmp/nginx-uwsgi \
  /tmp/nginx-scgi
chmod 1777 /tmp/nginx-body /tmp/nginx-proxy /tmp/nginx-fastcgi /tmp/nginx-uwsgi /tmp/nginx-scgi
if [ ! -f /opt/data/etc/config.yaml ]; then
  cp /usr/local/share/dns-host/config.example.yaml /opt/data/etc/config.yaml
fi
# Move leftover flat per-zone files into <hh>/<ll>/. Safe to repeat.
python3 -m dns_host.shard
exec /sbin/init
