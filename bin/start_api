#!/bin/sh
set -eu
i=0
while [ ! -S /dev/log ] && [ "$i" -lt 50 ]; do
  i=$((i + 1))
  sleep 0.1
done
# 1003 is the API's config failure. ps shows "sleep 1003".
python3 -c 'from dns_host.config import Settings; Settings.load().require_service_ns()' || exec sleep 1003
exec python3 -m dns_host.serve_api
