#!/bin/sh
set -eu
i=0
while [ ! -S /dev/log ] && [ "$i" -lt 50 ]; do
  i=$((i + 1))
  sleep 0.1
done
mkdir -p /run/nginx /tmp/nginx-body /tmp/nginx-proxy /tmp/nginx-fastcgi /tmp/nginx-uwsgi /tmp/nginx-scgi /tmp/nginx-log
chmod 1777 /tmp/nginx-body /tmp/nginx-proxy /tmp/nginx-fastcgi /tmp/nginx-uwsgi /tmp/nginx-scgi
# 1001 is nginx's config-check failure. ps shows "sleep 1001".
python3 -m dns_host.serve_nginx || exec sleep 1001
exec nginx -e /tmp/nginx-startup.log -c /run/nginx/nginx.conf -g "daemon off;"
